# Public Nimiq JSON-RPC node the server reads the chain through.
NIMIQ_RPC_URL=

# Which Nimiq network the RPC node above is on: TestAlbatross or MainAlbatross.
NIMIQ_NETWORK=

# 64-character hex private key of the merchant wallet that receives test payments.
# Generate a fresh one with: npm run spike:genkey (inside packages/server).
SPIKE_MERCHANT_PRIVATE_KEY=

# Port the API server listens on.
PORT=8787

# Postgres connection string for the hosted database (Neon). Leave blank to use the
# local PGlite database under packages/server/.data, which needs no install.
DATABASE_URL=

# How often the chain watcher checks each merchant address, in milliseconds.
WATCHER_INTERVAL_MS=3000

# Browser origins allowed to call the API, comma separated, for example
# https://vango.app,http://localhost:3000. Leave blank to allow same-origin only.
ALLOWED_ORIGINS=
